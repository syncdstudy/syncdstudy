generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          Int                            @id @default(autoincrement())
  email       String                         @unique
  password    String
  role        Role                           @default(USER)
  preferences CourseNotificationPreference[]
  reports     Report[]
  courses     Course[]                       @relation("CourseToUser")
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model Course {
  id          Int                            @id @default(autoincrement())
  name        String                         @unique
  preferences CourseNotificationPreference[]
  users       User[]                         @relation("CourseToUser")
}

model CourseNotificationPreference {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  notify    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model StudySession {
  name         String
  date         DateTime       @db.Timestamptz(6)
  time         String
  mode         String?
  description  String?
  creator_id   String?        @db.Uuid
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  location     String?
  user         AppUser?       @relation(fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudySession_creator_id_fkey1")
  participants participants[]
}

model activitylog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String
  message    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model AppUser {
  id           String         @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String         @unique(map: "users_email_key")
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  first_name   String?
  last_name    String?
  year         String?
  major        String?        @default("''")
  minor        String?
  interests    String[]
  points       Int?           @default(0)
  role         String         @default("USER")
  password     String?
  StudySession StudySession[]
  participants participants[]

  @@map("app_users")
}

model Report {
  id           Int      @id @default(autoincrement())
  userId       Int?
  message      String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  contactEmail String?
  topic        String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model participants {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String        @db.Uuid
  session_id   String?       @db.Uuid
  created_at   DateTime?     @default(now()) @db.Timestamptz(6)
  StudySession StudySession? @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         AppUser       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model announcement {
  id         BigInt   @id @default(autoincrement())
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  excellent
  good
  fair
  poor
}
